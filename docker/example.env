MATRIX_HOMESERVER=
MATRIX_USERNAME=
MATRIX_PASSWORD=

# You can use a token instead of a password
# MATRIX_TOKEN=

# Name for bot's device
MATRIX_DEVICE=reminder-bot-device

# Only for verify your device and recover backup. 
# See "Verification" section in Readme or <recover> subcommand help page
# MATRIX_RECOVERY=your-recovery-key

# Timezone for reminders
TZ=Etc/UTC


# Optional parameters

# Language for bot messages.
# BOT_LANG=en
# Alternative to default and localized remind commands. Enter wihout exclamation mark.
# BOT_COMMAND=remind

# Default time for "morning", "afternoon", "evening" shortcuts for time.
# BOT_MORNING_TIME=09:00
# BOT_AFTERNOON_TIME=14:00
# BOT_EVENING_TIME=19:00
